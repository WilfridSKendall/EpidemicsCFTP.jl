@article{KendallMoeller-2000,
abstract = {In this paper we investigate the application of perfect simulation, in particular Coupling from the Past (CFTP), to the simulation of random point processes. We give a general formulation of the method of dominated CFTP and apply it to the problem of perfect simulation of general locally stable point processes as equilibrium distributions of spatial birth-and-death processes. We then investigate discrete-time Metropolis-Hastings samplers for point processes, and show how a variant which samples systematically from cells can be converted into a perfect version. An application is given to the Strauss point process.},
author = {Kendall, Wilfrid Stephen and M{\o}ller, Jesper},
doi = {10.1239/aap/1013540247},
file = {:home/wilfrid/Reading/Papers/K/KendallMoeller-2000.pdf:pdf},
issn = {0001-8678},
journal = {Advances in Applied Probability},
keywords = {Coupling from the Past (CFTP),Dominated CFTP,Exact simulation,Folder - DirichletMCMC,Local stability,Markov chain Monte Carlo,Metropolis–Hastings,Papangelou conditional intensity,Perfect simulation,Realizable monotonicity,Spatial birth-and-death process,Spatial point process,Stochastic monotonicity,Strauss process,WSK,stochastic geometry},
mendeley-tags = {Folder - DirichletMCMC,WSK,stochastic geometry},
month = {sep},
number = {3},
pages = {844--865},
title = {{Perfect simulation using dominating processes on ordered spaces, with application to locally stable point processes}},
url = {https://www.cambridge.org/core/product/identifier/S0001867800010284/type/journal{\_}article},
volume = {32},
year = {2000}
}


