using EpidemicsCFTP, EpidemicsCFTP.abbreviations
import EpidemicsCFTP: evolution_history

import Random

Random.seed!(44)

const population = 5
const duration   = 5
const cremoval_times = collect(1:3)
const iv0 = Innovation(5, I[], R[], [C(t,t) for t in cremoval_times])
const initial = SIR(0, population - 1, 1, 0)


ev = extremal_evolution(initial, duration, cremoval_times, maximal=false)
# println(sprint(show, MIME("text/plain"), ev))

for i in 1:4
    global ev, state
    ev = ev ∘ generate_innovation(iv0, duration)
    println("\nNFZ3:       ", ev.NFZ3)
    if any(t!=-Inf for t in ev.NFZ3)
        println("Infections: ", sprint(show, MIME("text/plain"), ev.infections))
        println("Expunged:   ", sprint(show, MIME("text/plain"), filter(z -> z isa XI, ev.infections)))
        println("Removals:  ", sprint(show, MIME("text/plain"), ev.removals))

        # Now we want to test `NFZ3` for latest `ev`.

        println("History:      ", sprint(show, MIME("text/plain"), ev.history))
        println("Trajectory:   ", sprint(show, MIME("text/plain"), ev.trajectory))

        # We need to attach states from `trajectory` to `ExpungedInfection`s
        # Create a dictionary mapping `history` to `trajectory[2:end]`

        state_dict = Dict(zip(ev.history, ev.trajectory[2:end]))
        println("Infections:  ",
                sprint(show, MIME("text/plain"), state_dict))
        println("XInfections: ",
                sprint(show, MIME("text/plain"),
                    filter(z -> z isa ExpungedInfection, ev.infections)))

        state = initial
        for z in sort(union(ev.history, filter(z -> z isa ExpungedInfection, ev.infections)))
            global state
            if z isa ExpungedInfection
                println(sprint(show, MIME("text/plain"), (z, state)))
                try
                    println(sprint(show, MIME("text/plain"),          evolution_history(state, sort(union(ev.chronology,
                                        [I(z)])), conditioned=true)))
                    error("Should not have succeeded!")
                catch e
                    println(e)
                end
            else
                state = state_dict[z]
            end
        end

    end
end



# Why does the SECOND ExpungedInfection not lead to an exception?!


